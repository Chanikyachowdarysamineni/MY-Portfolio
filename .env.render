# Environment Variables for Render
# These are used by BOTH frontend and backend services

# ============ BACKEND ONLY ============
# MongoDB Atlas Connection String
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://raavanaasura87_db_user:Chani8877@chani.irvyksk.mongodb.net/portfolio?retryWrites=true&w=majority

# Server Environment
NODE_ENV=production

# Server Port (Render assigns automatically)
PORT=5000

# ============ FRONTEND ONLY ============
# Backend API URL - Points to the backend service on Render
# Format: https://portfolio-backend.onrender.com (adjust if your Render service name is different)
VITE_BACKEND_URL=https://portfolio-backend.onrender.com
